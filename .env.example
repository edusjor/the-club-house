# Base de datos (Neon PostgreSQL)
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"

# Auth.js / NextAuth
AUTH_SECRET="change-me-in-production"
# In production, set your real public URL, e.g. https://theclubhousecr.com
# In local development you can omit NEXTAUTH_URL and keep AUTH_TRUST_HOST=true
# NEXTAUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"

# Dev (optional): extra hosts allowed to request Next.js dev assets/HMR.
# Comma-separated hostnames/IPs, e.g. "172.16.28.177,my-laptop.local"
# NEXT_ALLOWED_DEV_ORIGINS=""

# Docker compose host port (optional). Default used in compose: 4387
DOCKER_HOST_PORT="4387"

# Upload
UPLOAD_DIR="./public/uploads"

# SMTP (envío de correo para "olvidé mi contraseña")
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# "true" si usas el puerto 465 (SSL implícito); en 587/25 déjalo en "false" (STARTTLS)
SMTP_SECURE="false"
SMTP_USER="usuario@example.com"
SMTP_PASSWORD="change-me"
# Remitente que verán los usuarios. Debe ser un buzón que exista de verdad en tu hosting
# (muchos servidores rechazan el envío con "Sender verify failed" si el remitente no existe).
SMTP_FROM="The Club House <it@theclubhousecr.com>"
