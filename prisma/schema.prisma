generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  password     String
  role         String   @default("PARENT") // ADMIN, PARENT, VENDOR, STUDENT
  isStaff      Boolean  @default(false) // tags a PARENT-role account as school staff (still uses the parent portal)
  phone        String?
  cedula       String?
  avatar       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parentStudents       Student[]       @relation("ParentStudents")
  studentProfile       Student?        @relation("StudentProfile")
  payments             Payment[]
  orders               Order[]
  ordersCreated        Order[]         @relation("OrderCreatedBy")
  activityLogs         ActivityLog[]
  notifications        Notification[]
  paymentsApproved     Payment[]       @relation("ApprovedBy")
  parentBalance         ParentBalance?
  passwordResetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Student {
  id            String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("StudentProfile", fields: [userId], references: [id])
  name          String
  level         String
  allergies     String?
  photo         String?
  active        Boolean  @default(true)
  parentId      String
  parent        User     @relation("ParentStudents", fields: [parentId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems      OrderItem[]
  studentPackages StudentPackage[]
}

model FoodCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  foodItems    FoodItem[]
  packageItems PackageItem[]
}

model FoodItem {
  id            String       @id @default(cuid())
  name          String
  image         String?
  description   String?
  categoryId    String
  category      FoodCategory @relation(fields: [categoryId], references: [id])
  ingredients   String?
  tags          String?
  available     Boolean      @default(true)
  availableDays String?
  stockQuantity Int?
  fixedMealPeriod String?    // BREAK | LUNCH | AFTERSCHOOL | null (null = generic, orderable at any time)
  foodTab       String?      // GENERAL | DRINKS | CASADOS | SNACK | null (null = guess from name/category)
  visibility    String       @default("ALL") // ALL | VENDOR_ONLY (VENDOR_ONLY is hidden from parent/public menus and can't be ordered by parents; only vendor/admin can see and sell it)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  prices       FoodItemPrice[]
  orderItems   OrderItem[]
}

model MonthlyMenuImage {
  id        String   @id @default(cuid())
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

model FoodItemPrice {
  id         String   @id @default(cuid())
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id])
  level      String
  price      Int

  @@unique([foodItemId, level])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  description  String?
  validityDays Int?
  status       String   @default("ACTIVE")
  rules        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  packageItems    PackageItem[]
  studentPackages StudentPackage[]
  prices          PackagePrice[]
}

model PackagePrice {
  id        String   @id @default(cuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id])
  level     String
  price     Int

  @@unique([packageId, level])
}

model PackageItem {
  id         String       @id @default(cuid())
  packageId  String
  package    Package      @relation(fields: [packageId], references: [id])
  categoryId String
  category   FoodCategory @relation(fields: [categoryId], references: [id])
}

model StudentPackage {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id])
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("ACTIVE")
  consumed    Int       @default(0) // how many days this package has been used — informational only, doesn't gate eligibility
  pricePaid   Int       @default(0) // amount charged to the parent's balance at purchase — reversed/reapplied on cancel/reactivate
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  coveredOrderItems OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  parentId    String
  parent      User        @relation(fields: [parentId], references: [id])
  status      String      @default("PENDING")
  total       Int
  notes       String?
  source      String      @default("PARENT") // PARENT (app) or VENDOR (walk-in at the restaurant)
  createdById String?
  createdBy   User?       @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id                        String          @id @default(cuid())
  orderId                   String
  order                     Order           @relation(fields: [orderId], references: [id])
  studentId                 String
  student                   Student         @relation(fields: [studentId], references: [id])
  foodItemId                String
  foodItem                  FoodItem        @relation(fields: [foodItemId], references: [id])
  scheduledDate             DateTime
  mealPeriod                String? // BREAK, LUNCH, AFTERSCHOOL (null for legacy/vendor items)
  quantity                  Int             @default(1)
  price                     Int
  delivered                 Boolean         @default(false)
  coveredByStudentPackageId String?         // set when this serving was covered by a monthly package instead of being charged
  coveredByStudentPackage   StudentPackage? @relation(fields: [coveredByStudentPackageId], references: [id])
}

model Payment {
  id           String   @id @default(cuid())
  parentId     String
  parent       User     @relation(fields: [parentId], references: [id])
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id])
  amount       Int
  receipt      String?
  status       String   @default("PENDING")
  comment      String?
  approvedById String?
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ParentBalance {
  id              String   @id @default(cuid())
  parentId        String   @unique
  parent          User     @relation(fields: [parentId], references: [id])
  pendingBalance  Int      @default(0)
  approvedBalance Int      @default(0)
  creditBalance   Int      @default(0) // money paid/approved beyond what's actually charged (e.g. an overpayment approved on purpose) — available to offset future charges, never silently dropped
  creditLimit     Int      @default(100000) // max pendingBalance allowed before new orders are blocked; admin can raise per-parent
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                String    @id @default("singleton")
  comingSoonEnabled Boolean   @default(false)
  comingSoonAt      DateTime?
  updatedAt         DateTime  @updatedAt
}
